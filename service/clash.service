[Unit]
Description=Clash Proxy
After=network.target

[Service]
Type=simple
User=cai
Group=users
WorkingDirectory=/home/cai/.clash
ExecStart=/home/cai/.local/bin/clash
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
